<div class="wrapper">
<%= form_for(seller) do |f| %>
  <% if seller.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(seller.errors.count, "error") %> prohibited this seller from being saved:</h2>

      <ul>
      <% seller.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

<div class="container">
						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Seller ID</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.text_field :seller_id , class: 'form-control', placeholder: "Seller ID" %>
							</div>
						</div>


						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Organization</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.text_field :organization , class: 'form-control', placeholder: "Organization" %>
							</div>
						</div>

						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Password</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.password_field :password , class: 'form-control', placeholder: "Password" %>
							</div>
						</div>


  <div class="actions">
    <%= f.submit "SignUp" , class: "actions btn  btn-primary" %>
  </div>
<% end %>

  </div>
</div>
