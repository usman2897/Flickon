
  <div class="wrapper">
				<h1 class="page-header">Login</h1>
        <%= form_tag :action => 'loggedin', class: "form-signin" do %>
        <div class="container">
						<div class="form-group row">
							<label for="seller_id" class="col-sm-2 col-form-label">Seller ID</label>
							<div class="col-sm-10">
								<%= text_field 'sellers', 'seller_id' , class: 'form-control', placeholder: "Username" %>
							</div>
						</div>
      
						<div class="form-group row">
							<label for="password" class="col-sm-2 col-form-label">Password</label>
							<div class="col-sm-10">
								<%= password_field 'sellers', 'password', class: 'form-control', placeholder: "Password" %>
							</div>
						</div>
            
						<div >
								<%= submit_tag "Login", class: "actions btn  btn-primary" %>
						</div>						
            
        </div>
        <% end -%>

  </div>




