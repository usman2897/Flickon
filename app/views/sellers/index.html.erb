<p id="notice"><%= notice %></p>

<h1>Sellers</h1>

<table>
  <thead>
    <tr>
      <th>Organization</th>
      <th>Password</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @sellers.each do |seller| %>
      <tr>
        <td><%= seller.organization %></td>
        <td><%= seller.password %></td>
        <td><%= link_to 'Show', seller %></td>
        <% if account_seller_signed_in? %>
          <% @current = current_account_seller %>
          <% if @current.seller_id == item.seller_id %>
            <td><%= link_to 'Edit', edit_seller_path(seller) %></td>
            <td><%= link_to 'Destroy', seller, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          <% end %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
