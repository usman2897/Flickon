<style>
  .navbar-nav > li{
  margin-left:20px;
  margin-right:20px;
  margin-top:5px;
  color:#e4c49b;
}



.navbar a{
    color: #F8F8FF !important;
}

.nav-padding {
  padding:5px;
}

.navbar{
  height: 40px !important;
  font-size: 10px !important;
}
</style>


<!DOCTYPE html>
<html>
  <head>
    <title>OnlineShopping</title>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  </head>
 
  <body>

<div class="navbar navbar-light" style="background-color: #808080;">
      <div class="container">


      <!-- Collect the nav links, forms, and other content for toggling -->

        <ul class="nav navbar-nav" >
        <% url = request.original_url %>
        <% if account_user_signed_in? && cookies.signed[:id] == 'user' %>
          <% @current_user = current_account_user %>
          <li><i class="fa fa-user-o fa-2x nav-padding" ><%= link_to @current_user.user_id, @current_user  %></i></li>
          <li> <i class="fa fa-home fa-2x nav-padding" >
            <%= link_to 'Home', { controller: "items", action: "index" } %></i> </li>
          <li> <i class="fa fa-shopping-bag fa-2x nav-padding" ><%= link_to 'My Orders', { controller: "orders", action: "index" } %> </i></li>
          <li> <i class="fa fa-file-text-o fa-2x nav-padding" >
            <%= link_to 'Feedback', { controller: "feedbacks", action: "new" } %></i> </li>
          <li><i class="fa fa-reply fa-2x nav-padding"   ><%= link_to 'Logout', users_logout_path %></i></li>


        <% elsif account_seller_signed_in? && cookies.signed[:id] == 'seller' %>
          <% @current_seller = current_account_seller %>
          <li><i class="fa fa-user-o fa-2x nav-padding"   ><%= link_to @current_seller.seller_id, @current_seller %></i></li>
          <li><i class="fa fa-home fa-2x nav-padding"   ><%= link_to 'Home', sellers_my_items_path %></i> </li>
          <li><i class="fa fa-rupee fa-2x nav-padding"   ><%= link_to 'Sell Item', new_item_path %></i></li>
          <li><i class="fa fa-dashboard fa-2x nav-padding"   ><%= link_to "Dashboard", sellers_dashboard_path %></i></li>
          <li><i class="fa fa-reply fa-2x nav-padding"   ><%= link_to 'Logout', sellers_logout_path %></i></li>
        
        <% elsif url['users/login'] %>
          <li><i class="fa    fa-2x nav-padding"   ><%= link_to 'Seller Login', sellers_login_path  %></i></li>
          <li><i class="fa    fa-2x nav-padding"   ><%= link_to 'Sign Up', new_user_path  %></i></li>
        
        <% elsif url['sellers/login'] %>
          <li><i class="fa    fa-2x nav-padding"   ><%= link_to 'User Login', users_login_path  %></i></li>
          <li><i class="fa    fa-2x nav-padding"   ><%= link_to 'Sign Up', new_seller_path  %></i></li>
        
        <% else %>
          <li><i class="fa  fa-2x nav-padding"   ><%= link_to 'Login', users_login_path %></i></li>
          <li><i class="fa    fa-2x nav-padding"   ><%= link_to 'Sign Up', new_user_path  %></i></li>
        <% end %>
          <li style='width:30%;float:right;'>
            <%= form_tag({:action => 'search', :controller => 'items'}, {:method => 'get'}) do %>
            <div class='input-group'>
              <%= search_field_tag :search, value = nil, options = {placeholder: 'search...', class: 'form-control'} %>
              <span class='input-group-btn'><%= submit_tag 'search', class: ' btn btn-primary' %>
              </span>
            </div>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
    <%= yield %>
  </body>
</html>