<p id="notice"><%= notice %></p>
  <div class="wrapper">
				<h1 class="page-header">Login</h1>
        <%= form_tag :action => 'loggedin', class: "form-signin" do %>
        <div class="container">
						<div class="form-group row">
							<label for="inputEmail3" class="col-sm-2 col-form-label"> <i class="fa fa-user-circle-o" aria-hidden="true"></i> Username</label>
							<div class="col-sm-10">
								<%= text_field 'users', 'user_id', class: 'form-control', placeholder: "Username" %>
							</div>
						</div>
      
						<div class="form-group row">
							<label for="inputEmail3" class="col-sm-2 col-form-label"> <i class="fa fa-lock" aria-hidden="true"></i> Password</label>
							<div class="col-sm-10">
								<%= password_field 'users', 'password', class: 'form-control', placeholder: "Password" %>
							</div>
						</div>
            
						<div class="actions" >
								<%= submit_tag "Login", class: "actions btn  btn-primary" %>
						</div>						
            
        </div>
        <% end -%>

  </div>


