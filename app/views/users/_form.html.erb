<div class="wrapper">
<%= form_for(user) do |f| %>
  <% if user.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="container">
						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">User ID</label>
							<div class="col-sm-10" style="width:500px;">
								<%=  f.text_field :user_id  , class: 'form-control', placeholder: "Users ID" %>
							</div>
						</div>


						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">User Name</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.text_field :user_name , class: 'form-control', placeholder: "User Name" %>
							</div>
						</div>

						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Email</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.text_field :user_email  , class: 'form-control', placeholder: "example@domain.com" %>
							</div>
						</div>

						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Password</label>
							<div class="col-sm-10" style="width:500px;">
								<%= f.password_field :password  , class: 'form-control', placeholder: "Password" %>
							</div>
						</div>

						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Phone </label>
							<div class="col-sm-10" style="width:500px;">
								<%=  f.number_field :user_phone , class: 'form-control', placeholder: "9876543210" %>
							</div>
						</div>

						<div class="form-group row">
							<label  class="col-sm-1 col-form-label">Address </label>
							<div class="col-sm-10" style="width:500px;">
								<%=  f.text_area :address , class: 'form-control', placeholder: "#00, 0th Cross, 0th Main, XXX-000000" %>
							</div>
						</div>

  <div class="actions">
    <%= f.submit "SignUp" , class: "actions btn  btn-primary" %>
  </div>
<% end %>
</div>
  </div>





