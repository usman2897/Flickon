<%= form_for(order) do |f| %>
  <% if order.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul>
      <% order.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="field">
    <% if account_user_signed_in? && cookies.signed[:id] == 'user' %>
        <% @current_user = current_account_user %>
        <p>User: <%= @current_user.user_name %> </p>
    <% end %>
  </div>

  <div class="field">
    <% f.label :item_id %>
    <%= f.hidden_field :item_id %>
    <p>Item: <%= item.item_name %></p> 
  </div>

  <div class="field">
    <%= f.label :ordered_quantity %>
    <%= f.number_field :ordered_quantity, :value => 1, :min => 1, :max => item.quantity %>
  </div>

  <div class="field">
    <%= f.label :total_price %>
    <%= f.hidden_field :total_price %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
