

<p> Item Name : <%= $item.item_name %> </p>

<%= form_for(order) do |f| %>
  <% if order.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul>
      <% order.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  

  <div class="field">
    <%= f.label :ordered_quantity %>
    <%= f.number_field :ordered_quantity, :value => 1, :max => $item.quantity, :min => 1 %>
  </div>

  <div class="field">
    <%= f.label :address %>
    <%= f.text_area :address %>
  </div>
 
 <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
