<p id="notice"><%= notice %></p>

<h1>Item Prorerties</h1>

<table>
  <thead>
    <tr>
      <th>Item property</th>
      <th>Property value</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @item_prorerties.each do |item_prorerty| %>
      <tr>
        <td><%= item_prorerty.item_property %></td>
        <td><%= item_prorerty.property_value %></td>
        <td><%= link_to 'Show', item_prorerty %></td>
        <td><%= link_to 'Edit', edit_item_prorerty_path(item_prorerty) %></td>
        <td><%= link_to 'Destroy', item_prorerty, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Item Prorerty', new_item_prorerty_path %>
