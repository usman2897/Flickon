<%= form_for(@item, remote: true, format: :json, html: {class: :item_form} ) do |f| %>
  <% if item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
      <% item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :item_name %>
    <%= f.text_field :item_name %>
  </div>

  <div class="field">
    <%= f.label :category_id %>
    <%= f.collection_select :category_id, Category.all, :category_id, :category_name %>
  </div>

  <div class="field">
    <%= f.label :sub_category_id %>
    <%= f.collection_select :sub_category_id, SubCategory.all, :sub_category_id, :sub_category_name %>
  </div>

  <div class="field">
    <%= f.label :quantity %>
    <%= f.number_field :quantity %>
  </div>

  <div class="field">
    <%= f.label :price %>
    <%= f.text_field :price %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description %>
  </div>

  <div class="field">
    <%= f.label :seller_id %>
    <%= f.text_field :seller_id %>
  </div>

  <div class="field">
    <%= f.label :image %>
    <%= f.file_field :image %>
  </div>


    <div id = "new_property">
      <%= render partial: 'new_item_property' %>
      <%= render partial: 'new_item_property' %>
      <%= render partial: 'new_item_property' %>
    </div>
      <!--<a href="javascript:new_property.js" id="addNewProperty">Add New Property</a>-->
  <br>

    

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

<div style="display: none;" id="new_choice_form">
    <%= render partial: "new_item_property", locals: {item_property: false} %>
</div>


