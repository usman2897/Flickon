<h1>Items</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Item name</th>
      <th>Category</th>
      <th>Sub category</th>
      <th>Quantity</th>
      <th>Price</th>
      <th>Description</th>
      <th>Seller</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @items.each do |item| %>
      <% category = Category.find(item.category_id) %>
      <% sub_category = SubCategory.find(item.sub_category_id) %>
      <tr>
        <td><%= item.item_name %></td>
        <td><%= category.category_name %></td>
        <td><%= sub_category.sub_category_name %>    </td>
        <td><%= item.quantity %></td>
        <td><%= item.price %></td>
        <td><%= item.description %></td>
        <td><%= item.seller_id %></td>
        <td><%= link_to 'Show', item %></td>
        <% if account_seller_signed_in? %>
          <% @current = current_account_seller %>
          <% if @current.seller_id == item.seller_id %>
            <td><%= link_to 'Edit', edit_item_path(item) %></td>
            <td><%= link_to 'Destroy', item, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          <% end %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<% if cookies.signed[:id] == 'user' %>
  <%= link_to 'My Orders', { controller: "orders", action: "index" } %>
<% end %>

<% if cookies.signed[:id] == 'seller' %>
  <%= link_to 'New Item', new_item_path %>
<% end %>

